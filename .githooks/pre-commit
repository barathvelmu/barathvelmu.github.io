#!/bin/sh
# Regenerates the static Papers / Reports / Projects blocks in index.html from publications.json
# and stages the result, so the committed HTML never drifts from the data.
# Enabled per clone with: git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node is required to run build-static.js" >&2
  exit 1
fi

node build-static.js >/dev/null
git add index.html

# Second run must be a no-op; if not, the generator is not idempotent and the commit is unsafe.
node build-static.js >/dev/null
if ! git diff --quiet -- index.html; then
  echo "pre-commit: index.html still out of sync after build-static.js; refusing to commit" >&2
  exit 1
fi
